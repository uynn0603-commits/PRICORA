# Copy to .env.local for local development. Values below match docker-compose.yml.

# Runtime connection. This role is NOT the table owner, so row-level security applies to it.
DATABASE_URL=postgres://picora_api:picora_api@localhost:5434/picora
# Owner connection, used only by `npm run db:migrate` and `npm run db:seed`.
MIGRATION_DATABASE_URL=postgres://picora:picora@localhost:5434/picora
# Dates such as "expired today" are evaluated in this zone.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Signs album unlock tokens and local upload URLs. Use a long random string in production.
SESSION_SECRET=dev-only-change-me

# "local" keeps photos in .data/media and serves them from /api/media (development only).
# "s3" uploads straight from the browser to an S3-compatible bucket such as Cloudflare R2.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=picora-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket's objects (R2 custom domain or r2.dev URL).
# Leave empty for a private bucket: photos then go through /api/media/file, which redirects
# to a signed URL. See README "Lưu ảnh tạm trên Backblaze B2" for the B2 values.
# MEDIA_PUBLIC_URL=https://media.picora.vn

# Lets studio owners and the platform admin wipe everything back to the demo data.
ALLOW_DEMO_RESET=true
